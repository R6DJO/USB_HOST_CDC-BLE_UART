# Persistent defaults for the multi-connection BLE-UART bridge.
# Applied on `idf.py reconfigure` / clean builds.

# --- BLE: allow up to 4 simultaneous connections ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# up to 4 BLE peers
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# 4 connections + advertising + margin (controller BLE activities)
CONFIG_BT_CTRL_BLE_MAX_ACT=8

CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8

# Legacy (non-extended) advertising is used by the Nordic UART service.
# CONFIG_BT_NIMBLE_EXT_ADV is not set

# --- BLE Bridge (Nordic UART Service) ---
CONFIG_BLE_DEVICE_NAME="DMR-RADIO"

# --- Nordic UART component ---
CONFIG_NORDIC_UART_RX_BUFFER_SIZE=4096

# --- Message router ---
CONFIG_MSG_ROUTER_BUF_SIZE=8192
# Per-sink async delivery (variant C): private queue + dedicated task per sink
CONFIG_MSG_ROUTER_SINK_QUEUE_SIZE=4096
CONFIG_MSG_ROUTER_SINK_TASK_STACK=3072
CONFIG_MSG_ROUTER_STATS_PERIOD_MS=30000

# --- USB CDC (radio): Tyt MD-9600 0x1FC9:0x0094 @ 115200 8N1 ---
CONFIG_USB_CDC_DEVICE_VID=0x1FC9
CONFIG_USB_CDC_DEVICE_PID=0x0094
CONFIG_USB_CDC_BAUDRATE=115200
CONFIG_USB_CDC_TX_TIMEOUT_MS=1000

# --- UART Bridge (pins/rates; adjust to your board wiring) ---
# UART Radio: auto-baud probes 9600 then 115200 via 'AT'
CONFIG_UART_RADIO_NUM=1
CONFIG_UART_RADIO_TX_GPIO=17
CONFIG_UART_RADIO_RX_GPIO=18
CONFIG_UART_RADIO_BUF_SIZE=512
CONFIG_UART_RADIO_STARTUP_DELAY_MS=5000
CONFIG_UART_RADIO_PROBE_ATTEMPTS=3
# UART Lora: fixed baud (default 9600)
CONFIG_UART_LORA_NUM=2
CONFIG_UART_LORA_TX_GPIO=21
CONFIG_UART_LORA_RX_GPIO=47
CONFIG_UART_LORA_BAUDRATE=9600
CONFIG_UART_LORA_BUF_SIZE=512
