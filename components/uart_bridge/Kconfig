menu "UART Bridge"

    menu "UART Radio (AT, auto-baud 9600/115200)"
        config UART_RADIO_NUM
            int "UART peripheral number"
            default 1
            range 0 2
            help
                Which UART controller to use for the Radio AT link.
                UART0 is usually the log console, so prefer UART1 or UART2.

        config UART_RADIO_TX_GPIO
            int "TX GPIO"
            default 17
            range 0 48
            help
                GPIO connected to the Radio's RX line.

        config UART_RADIO_RX_GPIO
            int "RX GPIO"
            default 18
            range 0 48
            help
                GPIO connected to the Radio's TX line.

        config UART_RADIO_BUF_SIZE
            int "RX scratch buffer size (bytes)"
            default 512
            range 128 4096

        config UART_RADIO_STARTUP_DELAY_MS
            int "Delay before first probe (ms)"
            default 5000
            range 0 60000
            help
                How long to wait after boot before the auto-baud task starts
                probing the AT radio link (lets USB/BLE settle first).

        config UART_RADIO_PROBE_ATTEMPTS
            int "Max probe attempts"
            default 3
            range 1 20
            help
                Number of full baud-probing rounds (each round tries 9600 then
                115200 with an "AT"->"OK" + "AT+SYNCOVER"->"OK" exchange). After
                this many failed rounds the radio bridge stays disabled instead
                of retrying forever.
    endmenu

    menu "UART Lora (fixed baud)"
        config UART_LORA_NUM
            int "UART peripheral number"
            default 2
            range 0 2
            help
                Which UART controller to use for the Lora link.
                Must differ from the Radio UART peripheral.

        config UART_LORA_TX_GPIO
            int "TX GPIO"
            default 21
            range 0 48
            help
                GPIO connected to the Lora module's RX line.

        config UART_LORA_RX_GPIO
            int "RX GPIO"
            default 47
            range 0 48
            help
                GPIO connected to the Lora module's TX line.

        config UART_LORA_BAUDRATE
            int "Baud rate"
            default 9600
            range 1200 5000000
            help
                Fixed baud rate for the Lora link (default 9600).

        config UART_LORA_BUF_SIZE
            int "RX scratch buffer size (bytes)"
            default 512
            range 128 4096
    endmenu

endmenu
